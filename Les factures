<!DOCTYPE html>
<html lang="fr"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Facture | Amine Rent A Car</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{--ink:#1C1F22;--red:#D62828;--line:#d9dad6}
*{box-sizing:border-box}body{margin:0;background:#e9eae7;font:14px/1.45 system-ui,'Segoe UI',Arial,sans-serif;color:#202225}
.bar{background:var(--ink);color:#fff;padding:10px 16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.bar button,.bar a{background:var(--red);color:#fff;border:0;border-radius:8px;padding:9px 14px;font:700 14px inherit;cursor:pointer;text-decoration:none}
.warn{background:#fff6dc;border-bottom:3px solid #C9A227;padding:10px 16px;font-size:13px}
.page{width:210mm;min-height:297mm;margin:16px auto;background:#fff;padding:16mm;box-shadow:0 2px 12px rgba(0,0,0,.15);position:relative}
.top{display:flex;justify-content:space-between;gap:20px;border-bottom:3px solid var(--red);padding-bottom:12px}
h1{margin:0;font-size:26px;letter-spacing:.02em}.small{font-size:12px;color:#63676b}
.two{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:18px 0}
.box{border:1px solid var(--line);border-radius:8px;padding:12px}.box h4{margin:0 0 6px;font-size:12px;text-transform:uppercase;color:#63676b}
table{width:100%;border-collapse:collapse;margin-top:6px}th{background:#F1F2F0;text-align:left;font-size:12px}
th,td{padding:8px;border-bottom:1px solid var(--line)}td.r,th.r{text-align:right;white-space:nowrap}
.tot td{border:0;padding:4px 8px}.tot .g td{font-size:17px;font-weight:800;border-top:2px solid var(--ink);padding-top:8px}
.foot{margin-top:26px}.qrw{text-align:center;font-size:10px;color:#63676b}
#qr{width:96px;height:96px}.ph{background:#fff3cd;padding:0 4px;border-radius:3px}
.msg{padding:30px;text-align:center}
@media print{body{background:#fff}.bar,.warn{display:none!important}.page{margin:0;box-shadow:none;width:auto;min-height:auto;padding:0}@page{size:A4;margin:14mm}}
</style></head>
<body>
<div class="bar"><button id="pr" type="button">Imprimer / Enregistrer en PDF</button><a href="admin.html">← Retour admin</a><span id="st"></span></div>
<div class="warn" id="warn" hidden></div>
<div id="out"><div class="msg">Chargement…</div></div>
<script>
const SB=supabase.createClient("https://tadaqaqvtjcnanspcboj.supabase.co","sb_publishable_fA2Est6rYrP6Sx1xfyhdOA_IA5TQ6MO");
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const m=n=>Number(n??0).toLocaleString("fr-FR",{minimumFractionDigits:3,maximumFractionDigits:3})+" TND";
const d=x=>x?new Date(x).toLocaleDateString("fr-FR",{timeZone:"Africa/Tunis"}):"";
const ph=v=>v?esc(v):'<span class="ph">[à renseigner]</span>';
$("pr").onclick=()=>window.print();
(async()=>{
  const id=new URLSearchParams(location.search).get("id");
  const {data:inv,error}=await SB.from("invoices").select("*").eq("id",id||"").maybeSingle();
  if(error||!inv){$("out").innerHTML='<div class="msg">Facture introuvable ou accès refusé (connectez-vous d\'abord à l\'administration).</div>';return}
  const s=inv.snapshot,c=s.company||{},cu=s.customer||{},isCN=inv.kind==="credit_note";
  const o=isCN?(s.original||{}):s, ov=isCN?(s.original?.vehicle||{}):(s.vehicle||{});
  $("st").textContent=inv.number;
  if(!isCN&&s.levy_vat_treatment==="to_confirm"){$("warn").hidden=false;$("warn").textContent="⚠️ Traitement fiscal de la taxe de location et TVA à faire valider par votre comptable avant usage officiel. (Ce bandeau ne s'imprime pas.)"}
  const lines=isCN?`<tr><td>Avoir annulant la facture ${esc(s.original_number)}</td><td class="r">${m(s.total_ttc)}</td></tr>`:
   `<tr><td>Location ${esc(ov.name)}${ov.plate?" ("+esc(ov.plate)+")":""}<div class="small">du ${d(s.start_date)} au ${d(s.end_date)} : ${esc(s.days)} jour(s) × ${m(s.daily_htva)} HTVA</div></td><td class="r">${m(s.subtotal_htva)}</td></tr>
    <tr><td>Taxe de location (${m(s.levy_per_day)} × ${esc(s.days)} jour(s))</td><td class="r">${m(s.levy_total)}</td></tr>`;
  const totals=isCN?`<tr class="g"><td>Total TTC de l'avoir</td><td class="r">${m(s.total_ttc)}</td></tr>`:
   `<tr><td>Sous-total HTVA</td><td class="r">${m(s.subtotal_htva)}</td></tr>
    <tr><td>TVA (${esc(s.vat_rate)} %)</td><td class="r">${m(s.vat_amount)}</td></tr>
    <tr><td>Taxe de location</td><td class="r">${m(s.levy_total)}</td></tr>
    ${+s.fiscal_stamp>0?`<tr><td>Timbre fiscal</td><td class="r">${m(s.fiscal_stamp)}</td></tr>`:""}
    <tr class="g"><td>Total TTC</td><td class="r">${m(s.total_ttc)}</td></tr>
    <tr><td>Acompte versé</td><td class="r">${m(s.deposit_paid)}</td></tr>
    <tr><td><b>Reste à payer</b></td><td class="r"><b>${m(s.balance_due)}</b></td></tr>`;
  $("out").innerHTML=`<div class="page">
   <div class="top"><div><h1>${isCN?"AVOIR":"FACTURE"}</h1><div><b>N° ${esc(inv.number)}</b></div><div class="small">Émise le ${d(inv.issued_at)}</div></div>
     <div class="qrw"><div id="qr" style="margin:0 auto"></div>Scanner pour vérifier</div>
     <div style="text-align:right"><b>${esc(c.name)}</b><div class="small">${ph(c.address)}<br>Matricule fiscal : ${ph(c.tax_id)}<br>${esc(c.phone)} ${esc(c.email)}</div></div></div>
   <div class="two"><div class="box"><h4>Client</h4><b>${esc(cu.name)}</b><div class="small">${esc(cu.address)}${cu.tax_id?"<br>MF : "+esc(cu.tax_id):""}<br>${esc(cu.phone)}</div></div>
     <div class="box"><h4>${isCN?"Motif":"Paiement"}</h4>${isCN?esc(s.reason):"Mode : "+esc(s.payment_method)}</div></div>
   <table><thead><tr><th>Désignation</th><th class="r">Montant</th></tr></thead><tbody>${lines}</tbody></table>
   <table class="tot" style="width:60%;margin-left:auto">${totals}</table>
   <div class="foot small">${esc(s.footer)}<br>Vérifiez l'authenticité de ce document en scannant le QR code ci-dessus.</div></div>`;
  const url=location.origin+location.pathname.replace(/[^/]*$/,"")+"verify.html?t="+inv.verify_token;
  try{new QRCode($("qr"),{text:url,width:96,height:96,correctLevel:QRCode.CorrectLevel.M})}catch(e){$("qr").textContent="QR indisponible"}
})();
</script></body></html>
